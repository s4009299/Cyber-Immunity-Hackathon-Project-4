# Copy this file to tide-support-spike/.env. Do not commit the filled-in .env.
# Match the bootstrap credentials used when creating your local Docker container.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_DO_NOT_USE_LITERALLY

# Provision the realm used by this project's application and test plan.
NEW_REALM_NAME=support-spike
TIDECLOAK_LOCAL_URL=http://localhost:8080
CLIENT_APP_URL=http://localhost:3000
